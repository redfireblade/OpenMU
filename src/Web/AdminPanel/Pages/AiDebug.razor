    private static string GetBehaviorBadgeClass(string behavior)
    {
        return behavior switch
        {
            "战斗中" => "bg-danger",
            "追击中" => "bg-warning text-dark",
            "索敌中" => "bg-info text-dark",
            "巡逻中" or "换点中" => "bg-secondary",
            "回城补给" or "返回死亡点" => "bg-primary",
            "等待重生" => "bg-dark",
            "喝药中" or "加Buff" => "bg-success",
            _ => "bg-secondary",
        };
    }

    private static string GetRunModeBadgeClass(ExecutionMode mode)
    {
        return mode switch
        {
            ExecutionMode.Mode1D => "bg-primary",
            ExecutionMode.DAG => "bg-success",
            ExecutionMode.Degraded => "bg-danger",
            _ => "bg-secondary",
        };
    }

    private static string GetRunModeLabel(ExecutionMode mode)
    {
        return mode switch
        {
            ExecutionMode.Mode1D => "1D",
            ExecutionMode.DAG => "DAG",
            ExecutionMode.Degraded => "Degraded",
            _ => "?",
        };
    }

    /// <summary>解析看板待办 JSON 为显示对象。</summary>
    private static List<DashboardTodoItem> ParseDashboardTodos(string json)
    {
        try
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<DashboardTodoItem>>(json);
            return items ?? new();
        }
        catch
        {
            return new();
        }
    }

    /// <summary>获取待办状态 Badge。</summary>
    private static string GetTodoStatusBadge(string status)
    {
        return status switch
        {
            "InProgress" => "<span class='badge bg-primary'>执行中</span>",
            "Done" => "<span class='badge bg-success'>完成</span>",
            "Failed" => "<span class='badge bg-danger'>失败</span>",
            "Suspended" => "<span class='badge bg-warning'>挂起</span>",
            _ => "<span class='badge bg-secondary'>待处理</span>",
        };
    }

    /// <summary>看板待办显示记录。</summary>
    private sealed record DashboardTodoItem(int Index, string Title, string Type, string Status, string Module, bool IsCurrent);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && this._selectedDebugData is { } data)
        {
            await this.RenderMapAsync(data);
        }
    }

    public void Dispose()
    {
        this.StateProvider.PropertyChanged -= OnStateChanged;
        this._autoCts?.Cancel();
        this._autoCts?.Dispose();
    }
}
