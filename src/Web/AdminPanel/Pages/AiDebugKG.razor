@page "/aidebug/kg"
@using MUnique.OpenMU.AIPlayer.Knowledge.KnowledgeGraph
@using System.Threading
@implements IDisposable

<style>
    .kg-card { background-color: #1e1e1e; border-color: #444; }
    .kg-card-header { background-color: #2d2d2d; border-bottom-color: #444; color: #e0e0e0; font-weight: 600; }
    body { background-color: #121212; color: #e0e0e0; }
    .table { color: #d0d0d0; margin-bottom: 0; }
    .table-striped > tbody > tr:nth-of-type(odd) > * { color: #d0d0d0; background-color: #1a1a1a; }
    .table-striped > tbody > tr:nth-of-type(even) > * { background-color: #1e1e1e; }
    .table-sm td, .table-sm th { padding: 2px 6px !important; }
    .node-label { cursor: pointer; }
    .node-label:hover { color: #0d6efd; text-decoration: underline; }
    .edge-in { border-left: 3px solid #198754; padding-left: 8px; margin: 2px 0; }
    .edge-out { border-left: 3px solid #0d6efd; padding-left: 8px; margin: 2px 0; }
    pre { background: #1a1a1a; border: 1px solid #444; border-radius: 4px; padding: 8px; margin: 0; font-size: 12px; }
    .form-control, .form-select { background-color: #2d2d2d; border-color: #555; color: #e0e0e0; }
    .form-control:focus, .form-select:focus { background-color: #333; color: #fff; }
    .badge-type { font-size: 10px; font-weight: 500; }
    .search-highlight { background-color: #ffd70033; padding: 0 2px; border-radius: 2px; }
    hr { border-color: #444; margin: 0.5rem 0; }
</style>

<PageTitle>OpenMU: 知识图谱浏览器</PageTitle>

<div class="container-fluid">
    <h1>知识图谱浏览器</h1>
    <p class="text-secondary small">
        知识图谱包含游戏世界中所有实体及其关系，支持 Dijkstra 寻路、BFS 可达性分析、依赖链解析。
    </p>

    <div class="row">
        <!-- Left: Stats + Node List -->
        <div class="col-4">
            <!-- Stats Card -->
            <div class="card kg-card shadow-sm mb-3">
                <div class="card-header kg-card-header">图谱统计</div>
                <div class="card-body">
                    @if (_graph is null)
                    {
                        <div class="text-secondary">图谱未加载（服务器可能仍在启动中）</div>
                    }
                    else
                    {
                        <table class="table table-sm table-borderless mb-0 small">
                            <tr>
                                <td class="text-light-emphasis">节点总数</td>
                                <td class="text-end font-monospace">@_graph.NodeCount.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td class="text-light-emphasis">边总数</td>
                                <td class="text-end font-monospace">@_graph.EdgeCount.ToString("N0")</td>
                            </tr>
                        </table>
                        <hr />
                        <h6 class="text-light-emphasis small mb-2">按类型分布</h6>
                        <table class="table table-sm table-borderless mb-0 small">
                            @foreach (var kv in _nodeTypeCounts)
                            {
                                <tr>
                                    <td><span class="badge @GetNodeTypeBadge(kv.Key) badge-type">@kv.Key</span></td>
                                    <td class="text-end font-monospace">@kv.Value.ToString("N0")</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            </div>

            <!-- Search Card -->
            <div class="card kg-card shadow-sm mb-3">
                <div class="card-header kg-card-header">搜索节点</div>
                <div class="card-body">
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" class="form-control" @bind="_searchText"
                               @onkeydown="HandleSearchKeyDown" placeholder="输入标签搜索..." />
                        <button class="btn btn-primary" @onclick="SearchNodes">搜索</button>
                    </div>
                    <div class="mb-2">
                        <select class="form-select form-select-sm" @bind="_filterType">
                            <option value="">全部类型</option>
                            @foreach (var nt in Enum.GetValues<NodeType>())
                            {
                                <option value="@nt">@nt</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Result List -->
            @if (_searchResults is not null)
            {
                <div class="card kg-card shadow-sm mb-3">
                    <div class="card-header kg-card-header d-flex justify-content-between">
                        <span>搜索结果 (@_searchResults.Count)</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSearch">清除</button>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var node in _searchResults)
                            {
                                <li class="list-group-item node-label @(node.Id.Equals(_selectedNode?.Id) ? "active" : "")"
                                    @onclick="() => SelectNode(node)"
                                    style="background-color: @(node.Id.Equals(_selectedNode?.Id) ? "#0d6efd" : "#1e1e1e"); color: @(node.Id.Equals(_selectedNode?.Id) ? "white" : "#ccc"); border-color: #444;">
                                    <div class="d-flex justify-content-between">
                                        <span>
                                            <span class="badge @GetNodeTypeBadge(node.Type) badge-type me-1">@node.Type</span>
                                            @node.Label
                                        </span>
                                        <small class="text-secondary" style="color: @(node.Id.Equals(_selectedNode?.Id) ? "rgba(255,255,255,0.7)" : "#999") !important;">@node.Id.ToString()</small>
                                    </div>
                                </li>
                            }
                            @if (_searchResults.Count == 0)
                            {
                                <li class="list-group-item text-secondary" style="background-color: #1e1e1e; border-color: #444;">无匹配结果</li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else if (_allNodes is not null)
            {
                <!-- Browse by Type -->
                <div class="card kg-card shadow-sm mb-3">
                    <div class="card-header kg-card-header d-flex justify-content-between align-items-center">
                        <span>浏览节点 (@_allNodes.Count)</span>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" style="max-height: 500px; overflow-y: auto;">
                            @foreach (var node in _allNodes)
                            {
                                <li class="list-group-item node-label @(node.Id.Equals(_selectedNode?.Id) ? "active" : "")"
                                    @onclick="() => SelectNode(node)"
                                    style="background-color: @(node.Id.Equals(_selectedNode?.Id) ? "#0d6efd" : "#1e1e1e"); color: @(node.Id.Equals(_selectedNode?.Id) ? "white" : "#ccc"); border-color: #444;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>
                                            <span class="badge @GetNodeTypeBadge(node.Type) badge-type me-1">@node.Type</span>
                                            @node.Label
                                        </span>
                                        <small class="text-secondary" style="color: @(node.Id.Equals(_selectedNode?.Id) ? "rgba(255,255,255,0.7)" : "#999") !important;">@node.Id.ToString()</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Node Details -->
        <div class="col-8">
            @if (_selectedNode is not null)
            {
                <div class="card kg-card shadow-sm mb-3">
                    <div class="card-header kg-card-header">节点详情</div>
                    <div class="card-body">
                        <table class="table table-sm table-borderless mb-0 small">
                            <tr>
                                <td class="text-light-emphasis" style="width: 100px;">ID</td>
                                <td class="font-monospace">@_selectedNode.Id.ToString()</td>
                            </tr>
                            <tr>
                                <td class="text-light-emphasis">标签</td>
                                <td><strong>@_selectedNode.Label</strong></td>
                            </tr>
                            <tr>
                                <td class="text-light-emphasis">类型</td>
                                <td><span class="badge @GetNodeTypeBadge(_selectedNode.Type) badge-type">@_selectedNode.Type</span></td>
                            </tr>
                            @if (_selectedNode.Properties is { Count: > 0 })
                            {
                                <tr>
                                    <td class="text-light-emphasis" style="vertical-align: top;">属性</td>
                                    <td>
                                        <table class="table table-sm table-borderless mb-0 small">
                                            @foreach (var prop in _selectedNode.Properties)
                                            {
                                                <tr>
                                                    <td class="text-secondary" style="width: 120px;">@prop.Key</td>
                                                    <td class="font-monospace">@prop.Value</td>
                                                </tr>
                                            }
                                        </table>
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <div class="row">
                    <!-- Outgoing Edges -->
                    <div class="col-6">
                        <div class="card kg-card shadow-sm mb-3">
                            <div class="card-header kg-card-header">
                                <span>出边 (从 @_selectedNode.Label 出发)</span>
                                <span class="badge bg-primary ms-2">@_outgoingEdges.Count</span>
                            </div>
                            <div class="card-body p-0">
                                @if (_outgoingEdges.Count == 0)
                                {
                                    <div class="p-3 text-secondary small">无出边</div>
                                }
                                else
                                {
                                    <div style="max-height: 400px; overflow-y: auto;">
                                        @foreach (var edge in _outgoingEdges)
                                        {
                                            <div class="edge-out p-2 small border-bottom border-secondary">
                                                <div class="d-flex justify-content-between">
                                                    <span class="badge bg-info badge-type">@edge.Type</span>
                                                    <span class="text-secondary font-monospace">w=@edge.Weight.ToString("F2")</span>
                                                </div>
                                                <div class="mt-1">
                                                    → <span class="node-label" @onclick="() => SelectNodeById(edge.Target)">
                                                        @GetNodeLabel(edge.Target)
                                                    </span>
                                                    <small class="text-secondary">@edge.Target.ToString()</small>
                                                </div>
                                                @if (edge.Properties is { Count: > 0 })
                                                {
                                                    <div class="text-secondary mt-1" style="font-size: 11px;">
                                                        @string.Join(", ", edge.Properties.Select(p => $"{p.Key}={p.Value}"))
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Incoming Edges -->
                    <div class="col-6">
                        <div class="card kg-card shadow-sm mb-3">
                            <div class="card-header kg-card-header">
                                <span>入边 (指向 @_selectedNode.Label)</span>
                                <span class="badge bg-success ms-2">@_incomingEdges.Count</span>
                            </div>
                            <div class="card-body p-0">
                                @if (_incomingEdges.Count == 0)
                                {
                                    <div class="p-3 text-secondary small">无入边</div>
                                }
                                else
                                {
                                    <div style="max-height: 400px; overflow-y: auto;">
                                        @foreach (var edge in _incomingEdges)
                                        {
                                            <div class="edge-in p-2 small border-bottom border-secondary">
                                                <div class="d-flex justify-content-between">
                                                    <span class="badge bg-info badge-type">@edge.Type</span>
                                                    <span class="text-secondary font-monospace">w=@edge.Weight.ToString("F2")</span>
                                                </div>
                                                <div class="mt-1">
                                                    ← <span class="node-label" @onclick="() => SelectNodeById(edge.Source)">
                                                        @GetNodeLabel(edge.Source)
                                                    </span>
                                                    <small class="text-secondary">@edge.Source.ToString()</small>
                                                </div>
                                                @if (edge.Properties is { Count: > 0 })
                                                {
                                                    <div class="text-secondary mt-1" style="font-size: 11px;">
                                                        @string.Join(", ", edge.Properties.Select(p => $"{p.Key}={p.Value}"))
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Path Query Section -->
                <div class="card kg-card shadow-sm mb-3">
                    <div class="card-header kg-card-header">路径查询</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-4">
                                <label class="form-label small text-secondary">起点</label>
                                <input type="text" class="form-control form-control-sm" @bind="_pathFrom" placeholder="Map(3)" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-secondary">终点</label>
                                <input type="text" class="form-control form-control-sm" @bind="_pathTo" placeholder="Item(0,15)" />
                            </div>
                            <div class="col-4">
                                <button class="btn btn-sm btn-primary" @onclick="FindPath">查找最短路径</button>
                            </div>
                        </div>
                        @if (_pathResult is not null)
                        {
                            <hr />
                            @if (_pathResult.IsFound)
                            {
                                <div class="small">
                                    <div class="mb-1">
                                        <span class="text-success">路径找到</span>
                                        <span class="text-secondary ms-2">总权重: @_pathResult.TotalWeight.ToString("F2")</span>
                                        <span class="text-secondary ms-2">步数: @(_pathResult.Edges.Count)</span>
                                    </div>
                                    <div style="max-height: 200px; overflow-y: auto;">
                                        @foreach (var edge in _pathResult.Edges)
                                        {
                                            <div class="d-flex align-items-center mb-1" style="font-size: 12px;">
                                                <span class="badge bg-secondary me-1">@edge.Type</span>
                                                <span class="text-secondary">@edge.Source.ToString()</span>
                                                <span class="mx-1">→</span>
                                                <span class="text-secondary">@edge.Target.ToString()</span>
                                                <span class="text-secondary ms-1">(w=@edge.Weight.ToString("F2"))</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-danger small mt-1">未找到路径</div>
                            }
                        }
                    </div>
                </div>

                <!-- Crafting Chain Section -->
                <div class="card kg-card shadow-sm">
                    <div class="card-header kg-card-header">合成链查询</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-8">
                                <label class="form-label small text-secondary">目标物品节点 ID</label>
                                <input type="text" class="form-control form-control-sm" @bind="_craftTargetId" placeholder="Item(12,15)" />
                            </div>
                            <div class="col-4">
                                <button class="btn btn-sm btn-success" @onclick="FindCraftingChain" disabled="@_isCraftingLoading">
                                    查询合成链
                                </button>
                            </div>
                        </div>
                        @if (_craftChainError is not null)
                        {
                            <div class="text-danger small mt-2">@_craftChainError</div>
                        }
                        @if (_craftChainTree is not null)
                        {
                            <hr />
                            <div class="small">
                                <div class="mb-2">
                                    <strong>@_craftChainLabel</strong>
                                    <span class="text-secondary ms-2">@_craftChainId</span>
                                    <span class="badge bg-info ms-2">@_craftChainStepCount 步依赖</span>
                                    @if (!_craftChainIsComplete)
                                    {
                                        <span class="badge bg-warning ms-2">部分结果（深度限制）</span>
                                    }
                                </div>
                                <div style="max-height: 400px; overflow-y: auto; font-size: 12px;">
                                    @RenderCraftTree(_craftChainTree, 0)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card kg-card shadow-sm">
                    <div class="card-body text-muted text-center py-5">
                        <h5>选择一个节点查看详情</h5>
                        <p class="small">在左侧列表中点击节点名称，或使用搜索框查找节点。</p>
                        <hr />
                        <h6 class="text-light-emphasis">快速链接</h6>
                        <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                            @foreach (var nt in Enum.GetValues<NodeType>())
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => BrowseByType(nt)">
                                    <span class="badge @GetNodeTypeBadge(nt) badge-type me-1">@nt</span>
                                    @GetTypeCount(nt)
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private KnowledgeGraph? _graph;
    private List<GraphNode>? _allNodes;
    private List<GraphNode>? _searchResults;
    private Dictionary<NodeType, int> _nodeTypeCounts = new();
    private GraphNode? _selectedNode;
    private List<GraphEdge> _outgoingEdges = new();
    private List<GraphEdge> _incomingEdges = new();
    private string _searchText = "";
    private string _filterType = "";
    private string _pathFrom = "";
    private string _pathTo = "";
    private PathResult? _pathResult;
    private string _craftTargetId = "";
    private List<CraftTreeNode>? _craftChainTree;
    private string? _craftChainLabel;
    private string? _craftChainId;
    private int _craftChainStepCount;
    private bool _craftChainIsComplete;
    private string? _craftChainError;
    private bool _isCraftingLoading;
    private readonly Dictionary<long, GraphNode> _nodeCache = new();
    private Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        _graph = KnowledgeGraphHolder.Graph;
        if (_graph is not null)
        {
            RefreshStats();
            // Load all nodes for browsing
            var nodes = _graph.GetAllNodes().ToList();
            _allNodes = nodes
                .OrderBy(n => n.Type)
                .ThenBy(n => n.Label)
                .ToList();
            foreach (var node in nodes)
            {
                _nodeCache[node.Id.Value] = node;
            }
        }

        // Auto-refresh every 5 seconds
        _refreshTimer = new Timer(_ => InvokeAsync(RefreshStats), null, 5000, 5000);
    }

    private void RefreshStats()
    {
        if (_graph is null) return;
        _nodeTypeCounts = _graph.GetAllNodes()
            .GroupBy(n => n.Type)
            .ToDictionary(g => g.Key, g => g.Count());
        StateHasChanged();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchNodes();
        }
    }

    private void SearchNodes()
    {
        if (_graph is null) return;

        var query = _searchText?.Trim().ToLowerInvariant() ?? "";
        var nodes = _graph.GetAllNodes().AsEnumerable();

        if (!string.IsNullOrEmpty(query))
        {
            nodes = nodes.Where(n => n.Label.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(_filterType) && Enum.TryParse<NodeType>(_filterType, out var ft))
        {
            nodes = nodes.Where(n => n.Type == ft);
        }

        _searchResults = nodes
            .OrderBy(n => n.Type)
            .ThenBy(n => n.Label)
            .ToList();
    }

    private void ClearSearch()
    {
        _searchText = "";
        _searchResults = null;
    }

    private void BrowseByType(NodeType type)
    {
        _filterType = type.ToString();
        _searchText = "";
        if (_graph is not null)
        {
            _allNodes = _graph.GetAllNodes()
                .Where(n => n.Type == type)
                .OrderBy(n => n.Label)
                .ToList();
        }
        StateHasChanged();
    }

    private void SelectNode(GraphNode node)
    {
        _selectedNode = node;
        _pathFrom = node.Id.ToString();

        if (_graph is not null)
        {
            _outgoingEdges = _graph.GetOutgoingEdges(node.Id).ToList();
            _incomingEdges = _graph.GetIncomingEdges(node.Id).ToList();
        }
    }

    private void SelectNodeById(NodeId id)
    {
        if (_graph is not null && _graph.TryGetNode(id, out var node) && node is not null)
        {
            SelectNode(node);
        }
    }

    private async Task FindPath()
    {
        _pathResult = null;
        if (KnowledgeGraphHolder.Instance is null) return;

        if (!NodeId.TryParse(_pathFrom, out var from) || !NodeId.TryParse(_pathTo, out var to))
        {
            return;
        }

        var result = KnowledgeGraphHolder.Instance.FindShortestPath(from, to);
        _pathResult = result;
    }

    private async Task FindCraftingChain()
    {
        _craftChainTree = null;
        _craftChainError = null;
        _craftChainLabel = null;
        _craftChainId = null;
        _isCraftingLoading = true;

        try
        {
            if (KnowledgeGraphHolder.Instance is null)
            {
                _craftChainError = "KG 未就绪";
                return;
            }

            if (!NodeId.TryParse(_craftTargetId, out var target))
            {
                _craftChainError = "无效的节点 ID 格式。示例: Item(12,15)";
                return;
            }

            var graph = KnowledgeGraphHolder.Graph;
            if (graph is null || !graph.TryGetNode(target, out var targetNode) || targetNode is null)
            {
                _craftChainError = $"节点 '{_craftTargetId}' 未找到";
                return;
            }

            // Craft-relevant edge types for backward traversal
            var craftEdgeTypes = new HashSet<EdgeType>
            {
                EdgeType.HasRecipe,
                EdgeType.RequiresMaterial,
                EdgeType.RequiresLevel,
                EdgeType.RequiresClass,
            };

            var chain = KnowledgeGraphHolder.Instance.ResolveDependencies(
                target, DependencyDirection.Backward, craftEdgeTypes, maxDepth: 10);

            _craftChainLabel = targetNode.Label;
            _craftChainId = target.ToString();
            _craftChainStepCount = chain.Steps.Count;
            _craftChainIsComplete = chain.IsComplete;

            // Build hierarchical tree
            var tree = BuildCraftTree(target, chain, graph);
            _craftChainTree = tree;
        }
        finally
        {
            _isCraftingLoading = false;
        }
    }

    // Recursive tree builder for crafting chains
    private static List<CraftTreeNode>? BuildCraftTree(NodeId nodeId, DependencyChain chain, KnowledgeGraph graph)
    {
        var parentDepth = chain.Steps
            .FirstOrDefault(s => s.NodeId.Equals(nodeId))?.Depth ?? 0;

        var children = chain.Steps
            .Where(s => s.Depth == parentDepth + 1)
            .Select(s =>
            {
                var subChain = new DependencyChain
                {
                    Target = s.NodeId,
                    Direction = chain.Direction,
                    Steps = chain.Steps.Where(x => x.Depth > s.Depth).ToList(),
                };
                return new CraftTreeNode
                {
                    NodeId = s.NodeId.ToString(),
                    Label = s.Label,
                    Type = graph.TryGetNode(s.NodeId, out var gn) ? gn?.Type.ToString() : null,
                    EdgeType = s.Edge.Type.ToString(),
                    Weight = s.Edge.Weight,
                    Children = BuildCraftTree(s.NodeId, subChain, graph),
                };
            }).ToList();

        return children.Count > 0 ? children : null;
    }

    // Recursive tree renderer for Blazor
    private RenderFragment RenderCraftTree(List<CraftTreeNode>? nodes, int depth) => builder =>
    {
        if (nodes is null) return;

        int seq = 0;
        foreach (var n in nodes)
        {
            // Indent
            if (depth > 0)
            {
                builder.AddContent(seq++, new string('\u00a0', depth * 2));
            }

            // Edge indicator (HasRecipe →, RequiresMaterial ←)
            if (!string.IsNullOrEmpty(n.EdgeType))
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "badge bg-info me-1");
                builder.AddAttribute(seq++, "style", "font-size: 10px;");
                builder.AddContent(seq++, n.EdgeType);
                builder.CloseElement();
            }

            // Type badge
            if (!string.IsNullOrEmpty(n.Type))
            {
                var badgeClass = n.Type switch
                {
                    "Item" => "bg-warning text-dark",
                    "CraftingRecipe" => "bg-secondary",
                    "PlayerClass" => "bg-dark",
                    _ => "bg-secondary"
                };
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", $"badge {badgeClass} me-1");
                builder.AddAttribute(seq++, "style", "font-size: 10px;");
                builder.AddContent(seq++, n.Type);
                builder.CloseElement();
            }

            // Label
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "node-label");
            builder.AddContent(seq++, n.Label ?? n.NodeId);
            builder.CloseElement();

            // NodeId (small)
            if (n.Label is not null)
            {
                builder.AddContent(seq++, " ");
                builder.OpenElement(seq++, "small");
                builder.AddAttribute(seq++, "class", "text-secondary");
                builder.AddContent(seq++, n.NodeId);
                builder.CloseElement();
            }

            // Weight
            builder.AddContent(seq++, " ");
            builder.OpenElement(seq++, "small");
            builder.AddAttribute(seq++, "class", "text-secondary");
            builder.AddContent(seq++, $"w={n.Weight:F2}");
            builder.CloseElement();

            builder.AddContent(seq++, "\n");

            // Children (recursive)
            if (n.Children is not null)
            {
                builder.AddContent(seq++, RenderCraftTree(n.Children, depth + 1));
            }
        }
    };

    private string GetNodeLabel(NodeId id)
    {
        if (_nodeCache.TryGetValue(id.Value, out var node))
        {
            return node.Label;
        }
        return $"?{id.ToString()}";
    }

    private string GetNodeTypeBadge(NodeType type) => type switch
    {
        NodeType.Map => "bg-secondary",
        NodeType.Monster => "bg-danger",
        NodeType.Item => "bg-warning text-dark",
        NodeType.Npc => "bg-info text-dark",
        NodeType.Quest => "bg-success",
        NodeType.MiniGameEvent => "bg-danger",
        NodeType.Skill => "bg-primary",
        NodeType.PlayerClass => "bg-dark",
        NodeType.CraftingRecipe => "bg-purple",
        _ => "bg-secondary"
    };

    private string GetTypeCount(NodeType type) =>
        _nodeTypeCounts.TryGetValue(type, out var count) ? $"({count})" : "(0)";

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    /// <summary>
    /// Represents a single node in the crafting chain tree.
    /// </summary>
    public sealed class CraftTreeNode
    {
        public string? NodeId { get; set; }
        public string? Label { get; set; }
        public string? Type { get; set; }
        public string? EdgeType { get; set; }
        public double Weight { get; set; }
        public List<CraftTreeNode>? Children { get; set; }
    }
}
