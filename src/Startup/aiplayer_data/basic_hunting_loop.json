{
  "id": "basic_hunting_loop",
  "name": "基础狩猎循环 v2.0 — 换点版",
  "version": "2.0.0",
  "status": "test",
  "description": "外挂级综合狩猎脚本 v2.0。支持换点、死亡恢复、补给回城、技能优先级。适用于 Map 3 (Noria)。",
  "category": "composite",
  "personality": "balanced",
  "orchestrator": {
    "mode": "dag"
  },

  "parameters": {
    "hpThreshold": 0.35,
    "mpThreshold": 0.20,
    "maxLevelDiff": 30,
    "patrolRadius": 15,
    "attackRange": 6.0,
    "pickupFilter": "all",
    "returnWhenInventoryFull": false,
    "searchRange": 20,
    "potionCooldownMs": 2000,
    "npcBlacklist": [],
    "durabilityThreshold": 0.1,
    "potionHysteresisMargin": 0.10,
    "returnCooldownSec": 120,
    "noMonsterTicksLimit": 30,
    "questGroup": 18,
    "questNumber": 1,
    "questNpcNumber": 257,
    "hotspots": [
      { "x": 190, "y": 200, "map": 3, "name": "蜘蛛区1", "x1": 130, "y1": 200, "x2": 195, "y2": 235 },
      { "x": 160, "y": 220, "map": 3, "name": "蜘蛛区2", "x1": 130, "y1": 200, "x2": 195, "y2": 235 },
      { "x": 140, "y": 210, "map": 3, "name": "蜘蛛区3", "x1": 130, "y1": 200, "x2": 195, "y2": 235 }
    ]
  },

  "paragraphs": [
    {
      "label": "start",
      "nodes": [
        {
          "name": "death_check",
          "condition": "is_dead",
          "action": "goto @recover",
          "comment": "死亡→跳转恢复段"
        },
        {
          "name": "just_revived_check",
          "condition": "just_revived",
          "action": "goto @recover",
          "comment": "刚复活→跳转恢复段"
        },
        {
          "name": "inventory_check",
          "condition": "inventory_nearly_full",
          "action": "goto @restock",
          "comment": "背包>80%→回城卖物补药"
        },
        {
          "name": "inventory_full_check",
          "condition": "inventory_full",
          "action": "goto @restock",
          "comment": "背包满→跳转补给段"
        },
        {
          "name": "equip_durable_check",
          "condition": "equip_durable_low",
          "action": "goto @restock",
          "comment": "装备耐久低→跳转补给段"
        },
        {
          "name": "submit_ready",
          "condition": "quest_conditions_met",
          "action": "goto @submit_quest",
          "comment": "任务条件满足→交任务"
        },
        {
          "name": "level_gate",
          "condition": "level_low",
          "action": "goto @hunt",
          "comment": "≤Lv15→不做任务，直接安全区巡逻练级"
        },
        {
          "name": "need_quest",
          "condition": "no_active_quest",
          "action": "goto @accept_quest",
          "comment": "Lv15+没有活跃任务→去接任务"
        },
        {
          "name": "enter_hunt",
          "condition": "always",
          "action": "goto @hunt",
          "comment": "条件正常→进入主狩猎段"
        }
      ]
    },

    {
      "label": "hunt",
      "nodes": [
        {
          "name": "death_check",
          "condition": "is_dead",
          "action": "goto @recover",
          "comment": "P0 死亡→跳转恢复段"
        },
        {
          "name": "revived_check",
          "condition": "just_revived",
          "action": "goto @recover",
          "comment": "P0.1 刚复活→跳转恢复段"
        },
        {
          "name": "quest_check",
          "condition": "quest_conditions_met",
          "action": "goto @submit_quest",
          "comment": "P0.2 任务完成检查"
        },
        {
          "name": "quest_hunt_redirect",
          "condition": "has_active_quest",
          "action": "goto @quest_hunt",
          "comment": "P0.3 有未完成任务→去任务区"
        },
        {
          "name": "map_check",
          "condition": "not_on_hunt_map",
          "action": "warp_to_map",
          "parameters": { "targetMapNumber": 3 },
          "comment": "P0.5 地图检查: 不在Noria→直接传送"
        },
        {
          "name": "regen_before_combat",
          "condition": "mp_below_threshold",
          "action": "sit_regen",
          "comment": "P0.6 打之前蓝不够→坐下回蓝"
        },
        {
          "name": "walking_guard",
          "condition": "is_walking",
          "action": "goto @hunt",
          "comment": "行走中→重新开始段落，不打断走路"
        },
        {
          "name": "emergency_combat",
          "condition": "monster_nearby",
          "action": "goto @combat",
          "comment": "附近有怪→停下战斗"
        },
        {
          "name": "target_shortcut",
          "condition": "has_target",
          "action": "goto @combat",
          "comment": "P1 有目标→跳转战斗段（跳过巡逻/拾取等非战斗节点）"
        },
        {
          "name": "find_target",
          "condition": "no_target",
          "action": "find_nearest_monster",
          "comment": "P2 无目标→索敌"
        },
        {
          "name": "hp_check",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "P3 喝红"
        },
        {
          "name": "mp_check",
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "comment": "P4 喝蓝"
        },
        {
          "name": "leave_safezone",
          "condition": "in_safe_zone",
          "action": "leave_safezone",
          "comment": "P5 脱安全区"
        },
        {
          "name": "pickup_items",
          "condition": "always",
          "action": "pickup_nearby",
          "comment": "P6 拾取物品"
        },
        {
          "name": "no_monsters_relocate",
          "condition": "no_monsters_recently",
          "action": "relocate_to_hotspot",
          "comment": "P7 长时间无怪→继续换热点"
        },
        {
          "name": "patrol",
          "condition": "always",
          "action": "random_patrol",
          "comment": "P8 巡逻"
        },
        {
          "name": "buff_check",
          "condition": "has_buff_to_cast",
          "action": "use_buff",
          "comment": "P99 最后加Buff（不干扰战斗）"
        }
      ]
    },
    {
      "label": "accept_quest",
      "nodes": [
        {
          "name": "warp_noria",
          "condition": "always",
          "action": "warp_to_map",
          "parameters": { "targetMapNumber": 3 },
          "comment": "确保在Noria"
        },
        {
          "name": "walk_to_npc",
          "condition": "always",
          "action": "walk_to_quest_npc",
          "parameters": { "questNpcNumber": 257 },
          "comment": "走向精灵战士"
        },
        {
          "name": "check_accepted",
          "condition": "has_active_quest",
          "action": "goto @quest_hunt",
          "comment": "已接任务先去蜘蛛区再狩猎"
        },
        {
          "name": "try_accept",
          "condition": "can_accept_quest",
          "action": "accept_quest",
          "parameters": { "questGroup": 18, "questNumber": 1 },
          "comment": "接任务"
        },
        {
          "name": "fallback",
          "condition": "always",
          "action": "goto @start",
          "comment": "回到主循环(接任务或未接成都要继续)"
        }
      ]
    },
    {
      "label": "combat",
      "nodes": [
        {
          "name": "death_check",
          "condition": "is_dead",
          "action": "goto @recover",
          "comment": "P0 战斗中死亡→跳转恢复"
        },
        {
          "name": "acquire_target",
          "condition": "no_target",
          "action": "find_nearest_monster",
          "comment": "P0.5 无目标→先索敌"
        },
        {
          "name": "pre_mp_check",
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "comment": "P0.6 开打前先补蓝"
        },
        {
          "name": "pre_hp_check",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "P0.7 开打前先补血"
        },
        {
          "name": "attack",
          "condition": "has_target_in_range",
          "action": "attack_target",
          "comment": "P1 攻击范围内目标（每次5连击）"
        },
        {
          "name": "hp_check",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "P3 战斗中喝红"
        },
        {
          "name": "mp_check",
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "comment": "P4 战斗中喝蓝"
        },
        {
          "name": "mp_regen",
          "condition": "mp_below_threshold",
          "action": "sit_regen",
          "comment": "P4.5 没蓝也没药了→坐下回蓝"
        },
        {
          "name": "target_alive_check",
          "condition": "has_target",
          "action": "goto @combat",
          "comment": "P6 目标还活着→继续战斗循环"
        },
        {
          "name": "return_to_hunt",
          "condition": "always",
          "action": "goto @hunt",
          "comment": "P99 目标死亡→回狩猎段"
        }
      ]
    },
    {
      "label": "quest_hunt",
      "nodes": [
        {
          "name": "death_check",
          "condition": "is_dead",
          "action": "goto @recover",
          "comment": "P0 死亡→跳转恢复段"
        },
        {
          "name": "revived_check",
          "condition": "just_revived",
          "action": "goto @recover",
          "comment": "P0.1 刚复活→跳转恢复段"
        },
        {
          "name": "quest_check",
          "condition": "quest_conditions_met",
          "action": "goto @submit_quest",
          "comment": "P0.2 任务完成→交任务"
        },
        {
          "name": "map_check",
          "condition": "not_on_hunt_map",
          "action": "warp_to_map",
          "parameters": { "targetMapNumber": 3 },
          "comment": "P0.5 先确保在Noria，再导航到热点"
        },
        {
          "name": "death_aware_skip_hotspot",
          "condition": "quest_has_deaths",
          "action": "goto @single_hunt",
          "comment": "死过→跳过密集热点，安全点寻单怪"
        },
        {
          "name": "quest_walking_guard",
          "condition": "is_walking",
          "action": "goto @quest_hunt",
          "comment": "行走中→重新开始段落，不打断走路"
        },
        {
          "name": "predator_check",
          "condition": "predator_nearby",
          "action": "relocate_to_hotspot",
          "comment": "附近有高等级怪→快速通过/绕路"
        },
        {
          "name": "quest_combat",
          "condition": "quest_target_nearby",
          "action": "goto @combat",
          "comment": "遇任务怪→停下打(高等级非任务怪绕开)"
        },
        {
          "name": "go_to_spider_zone",
          "condition": "not_at_hotspot",
          "action": "relocate_to_hotspot",
          "comment": "继续导航到热点(探索式寻径绕开高怪)"
        },
        {
          "name": "find_target",
          "condition": "no_target",
          "action": "find_nearest_monster",
          "comment": "P10 搜索怪物(优先任务目标)"
        },
        {
          "name": "target_shortcut",
          "condition": "has_target",
          "action": "goto @combat",
          "comment": "P15 有目标→跳转战斗段（先到热点再打）"
        },
        {
          "name": "hp_check",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "P3 喝红"
        },
        {
          "name": "mp_check",
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "comment": "P4 喝蓝"
        },
        {
          "name": "pickup_items",
          "condition": "always",
          "action": "pickup_nearby",
          "comment": "P5 拾取物品"
        },
        {
          "name": "no_monsters_relocate",
          "condition": "no_monsters_recently",
          "action": "relocate_to_hotspot",
          "comment": "P6 长时间无怪→继续换热点"
        },
        {
          "name": "patrol",
          "condition": "always",
          "action": "random_patrol",
          "comment": "P7 在热点周围巡逻"
        },
        {
          "name": "buff_check",
          "condition": "has_buff_to_cast",
          "action": "use_buff",
          "comment": "P99 最后加Buff（不干扰战斗）"
        }
      ]
    },
    {
      "label": "single_hunt",
      "nodes": [
        {
          "name": "death_check",
          "condition": "is_dead",
          "action": "goto @recover",
          "comment": "死亡→跳转恢复段"
        },
        {
          "name": "quest_check",
          "condition": "quest_conditions_met",
          "action": "goto @submit_quest",
          "comment": "任务完成→交任务"
        },
        {
          "name": "safe_find",
          "condition": "always",
          "action": "find_nearest_monster",
          "comment": "安全模式→寻单怪(避免密集热点)"
        },
        {
          "name": "target_shortcut",
          "condition": "has_target",
          "action": "goto @combat",
          "comment": "有目标→跳转战斗段"
        },
        {
          "name": "find_target",
          "condition": "no_target",
          "action": "find_nearest_monster",
          "comment": "无目标→安全索敌(优先任务怪)"
        },
        {
          "name": "hp_check",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "喝红"
        },
        {
          "name": "mp_check",
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "comment": "喝蓝"
        },
        {
          "name": "pickup_items",
          "condition": "always",
          "action": "pickup_nearby",
          "comment": "拾取掉落"
        },
        {
          "name": "patrol",
          "condition": "always",
          "action": "random_patrol",
          "comment": "在当前区域巡逻等怪刷新"
        },
        {
          "name": "buff_check",
          "condition": "has_buff_to_cast",
          "action": "use_buff",
          "comment": "最后加Buff"
        }
      ]
    },

    {
      "label": "relocate",
      "nodes": [
        {
          "name": "relocate_action",
          "condition": "always",
          "action": "relocate_to_hotspot",
          "comment": "换到下一个热点"
        },
        {
          "name": "return_to_hunt",
          "condition": "always",
          "action": "goto @hunt",
          "comment": "返回狩猎段"
        }
      ]
    },

    {
      "label": "recover",
      "nodes": [
        {
          "name": "wait_respawn",
          "condition": "is_dead",
          "action": "wait_respawn",
          "comment": "等待重生"
        },
        {
          "name": "warp_to_hunt_map",
          "condition": "not_on_hunt_map",
          "action": "warp_to_map",
          "parameters": { "targetMapNumber": 3 },
          "comment": "死后回 Noria (重生可能在其他地图)"
        },
        {
          "name": "hp_recover",
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "comment": "复活后补血"
        },
        {
          "name": "buff_reapply",
          "condition": "always",
          "action": "use_buff",
          "comment": "重新套buff"
        },
        {
          "name": "return_to_death_spot",
          "condition": "always",
          "action": "return_to_death_spot",
          "comment": "走回死亡地点"
        },
        {
          "name": "back_to_hunt",
          "condition": "always",
          "action": "goto @hunt",
          "comment": "恢复完成→返回狩猎段"
        }
      ]
    },

    {
      "label": "restock",
      "nodes": [
        {
          "name": "return_sell",
          "condition": "always",
          "action": "return_and_sell",
          "comment": "回城卖物修装备买药"
        },
        {
          "name": "refill_potions",
          "condition": "potion_count_below_threshold",
          "action": "use_hp_potion",
          "comment": "药水不足时补买（依赖 ReturnAndSell 内置买药）"
        },
        {
          "name": "return_to_start",
          "condition": "always",
          "action": "goto @start",
          "comment": "补给完成→回到入口段"
        }
      ]
    },

    {
      "label": "submit_quest",
      "nodes": [
        {
          "name": "warp_noria",
          "condition": "always",
          "action": "warp_to_map",
          "parameters": { "targetMapNumber": 3 },
          "comment": "确保在Noria"
        },
        {
          "name": "walk_to_npc",
          "condition": "always",
          "action": "walk_to_quest_npc",
          "parameters": { "questNpcNumber": 257 },
          "comment": "走向精灵战士"
        },
        {
          "name": "check_done",
          "condition": "no_active_quest",
          "action": "goto @start",
          "comment": "已交→回到开始检查下个任务"
        },
        {
          "name": "try_submit",
          "condition": "always",
          "action": "submit_quest",
          "parameters": { "questGroup": 18, "questNumber": 1 },
          "comment": "提交任务"
        }
      ]
    }
  ]
}
