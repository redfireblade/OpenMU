          "goto": "combat"
        },
        {
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "description": "战斗中蓝量低立即喝蓝",
          "goto": "combat"
        },
        {
          "condition": "inventory_full",
          "action": "travel_to_map",
          "parameters": {
            "mapId": 0
          },
          "description": "战斗过程中背包已满，回城清理",
          "goto": "maintenance"
        },
        {
          "condition": "equip_durable_low",
          "action": "travel_to_map",
          "parameters": {
            "mapId": 0
          },
