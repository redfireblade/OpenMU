{
  "id": "devias_hunting",
  "name": "冰风谷狩猎脚本",
  "version": "1.0.0",
  "status": "verified",
  "dslSource": "冰风谷狩猎脚本：适用于30-80级，在冰风谷区域自动打怪。主动攻击雪人、冰后等高经验怪物。追踪范围20格。背包满或装备耐久低时自动回城维护。段落模式：start→combat→maintenance",
  "parameters": {
    "searchRange": 20,
    "healThreshold": 0.35,
    "potionThreshold": 0.4,
    "huntingRange": 18,
    "pickupRange": 8
  },
  "priorityChain": [],
  "paragraphs": [
    {
      "label": "start",
      "nodes": [
        {
          "condition": "just_revived",
          "action": "relocate_to_hotspot",
          "description": "复活后返回冰风谷狩猎热点",
          "goto": "start"
        },
        {
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "description": "HP低于35%自动喝药补给",
          "goto": "start"
        },
        {
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "description": "MP低于阈值自动喝蓝恢复",
          "goto": "start"
        },
        {
          "condition": "inventory_full",
          "action": "travel_to_map",
          "parameters": {
            "mapId": 0
          },
          "description": "背包已满，回城清理背包",
          "goto": "maintenance"
        },
        {
          "condition": "equip_durable_low",
          "action": "travel_to_map",
          "parameters": {
            "mapId": 0
          },
          "description": "装备耐久度过低，回城修理",
          "goto": "maintenance"
        },
        {
          "condition": "potion_count_below_threshold",
          "action": "travel_to_map",
          "parameters": {
            "mapId": 0
          },
          "description": "药水数量不足，回城补给",
          "goto": "maintenance"
        },
        {
          "condition": "has_target",
          "action": "attack_target",
          "description": "发现攻击目标，进入战斗段落",
          "goto": "combat"
        },
        {
          "condition": "not_at_hotspot",
          "action": "relocate_to_hotspot",
          "description": "不在热点区域时重新定位到怪物热点",
          "goto": "start"
        },
        {
          "condition": "no_monsters_recently",
          "action": "relocate_to_hotspot",
          "description": "附近无怪，切换到其他热点区域",
          "goto": "start"
        },
        {
          "condition": "always",
          "action": "random_patrol",
          "description": "无目标时随机巡逻搜索高经验怪物",
          "goto": "combat"
        }
      ]
    },
    {
      "label": "combat",
