{
  "id": "lost_tower_hunting",
  "name": "失落之塔狩猎脚本",
  "version": "1.0.0",
  "status": "candidate",
  "dslSource": "失落之塔狩猎脚本：适用于80-150级，在失落之塔区域自动打怪。优先攻击高经验/高掉落收益的怪物。被多个怪物围攻时自动撤退到安全位置。使用大血瓶且阈值提升至50%以应对高伤害环境。段落模式：start→combat→emergency→loot",
  "parameters": {
    "searchRange": 18,
    "healThreshold": 0.5,
    "potionThreshold": 0.4,
    "huntingRange": 15,
    "pickupRange": 8,
    "dangerMonsterCount": 3
  },
