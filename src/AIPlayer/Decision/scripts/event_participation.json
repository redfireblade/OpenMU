{
  "id": "event_participation",
  "name": "事件参与脚本",
  "version": "1.0.0",
  "status": "candidate",
  "dslSource": "事件参与脚本：自动检测恶魔广场(DevilSquare)和血色城堡(BloodCastle)的开启状态。检查背包中是否持有对应的入场门票。有票则自动传送入场，入场后按事件规则执行攻击与生存逻辑。事件结束后自动返回常规狩猎地图继续挂机。",
  "parameters": {
    "searchRange": 10,
    "healThreshold": 0.5,
    "potionThreshold": 0.3,
    "eventCheckInterval": 60,
    "eventMapIds": [6, 7]
  },
  "priorityChain": [],
  "paragraphs": [
    {
      "label": "start",
      "nodes": [
        {
          "condition": "variable",
          "action": "warp_to_map",
          "parameters": {
            "varName": "event_devil_square_ready",
            "mapId": 6
          },
          "description": "恶魔广场已开启且有门票，传送至恶魔广场地图",
          "goto": "event"
        },
        {
          "condition": "variable",
          "action": "warp_to_map",
          "parameters": {
            "varName": "event_blood_castle_ready",
            "mapId": 7
          },
          "description": "血色城堡已开启且有门票，传送至血色城堡地图",
          "goto": "event"
        },
        {
          "condition": "is_on_target_map",
          "action": "random_patrol",
          "description": "已在事件地图中，直接执行事件逻辑",
          "goto": "event"
        },
        {
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "description": "等待事件过程中补血"
        },
        {
          "condition": "always",
          "action": "warp_to_hunt_map",
          "description": "无可用事件时返回狩猎地图继续挂机"
        }
      ]
    },
    {
      "label": "event",
      "nodes": [
        {
          "condition": "is_dead",
          "action": "relocate_to_hotspot",
          "description": "事件中死亡，等待复活机制处理"
        },
        {
          "condition": "hp_below_threshold",
          "action": "use_hp_potion",
          "description": "事件中血量低于50%喝血保命"
        },
        {
          "condition": "mp_below_threshold",
          "action": "use_mp_potion",
          "description": "事件中蓝量低喝蓝维持输出"
        },
        {
          "condition": "has_target_in_range",
          "action": "attack_target",
          "description": "攻击事件范围内的目标怪物"
        },
        {
          "condition": "has_target_not_in_range",
          "action": "random_patrol",
          "description": "追击远处的事件目标"
        },
        {
          "condition": "variable",
          "action": "warp_to_hunt_map",
          "parameters": {
            "varName": "event_ended"
          },
          "description": "检测到事件已结束，返回狩猎地图",
          "goto": "start"
        },
        {
          "condition": "no_target",
          "action": "random_patrol",
          "description": "事件中无目标时巡逻寻找",
          "goto": "event"
        },
        {
          "condition": "always",
          "action": "attack_target",
          "description": "事件中持续攻击保持活跃"
        }
      ]
    }
  ],
  "branchHitCounts": {},
  "orchestrator": null
}
